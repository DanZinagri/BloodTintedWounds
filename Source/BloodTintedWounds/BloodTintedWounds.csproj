<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<RootNamespace>BloodTintedWounds</RootNamespace>
		<AssemblyName>BloodTintedWounds</AssemblyName>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<Nullable>disable</Nullable>
		<DebugType>embedded</DebugType>
		<!-- Point these at your own installs if they live somewhere else. -->
		<RimWorldDir>E:\SteamLibrary\steamapps\common\RimWorld</RimWorldDir>
		<!-- VEF has no 1.7 build yet; its 1.6 assembly loads through the game's compatibility layer. -->
		<VEFDir>E:\SteamLibrary\steamapps\workshop\content\294100\2023507013\1.6\Assemblies</VEFDir>
		<OutputPath>..\..\1.7\Assemblies\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityStubs">
			<HintPath>$(RimWorldDir)\UnityStubs.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="VEF">
			<HintPath>$(VEFDir)\VEF.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>
